# =============================================================================
# AbsolutePestServices.com — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file — it is gitignored.
# Add all secrets as Replit Secrets (or your deployment platform's secret store).
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Session ---
SESSION_SECRET=your-long-random-session-secret

# --- SendGrid (Email) ---
SENDGRID_API_KEY=SG.xxxx

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Cloudinary (Photo Storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=AIzaxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxx

# --- Cloudflare Turnstile (CAPTCHA) ---
TURNSTILE_SECRET_KEY=your-turnstile-secret

# --- App Base URL ---
APP_BASE_URL=https://your-domain.com

# --- Facebook Page Integration ---
# Used by the Marketing Dashboard to display Facebook page metrics.
# Get these from Meta for Developers > Your App > Page Access Token Generator.
FB_PAGE_ID=298835070139713
FB_PAGE_ACCESS_TOKEN=your-page-access-token-here

# --- Replit (auto-injected in Replit environment — do not set manually) ---
# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=
